rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Artworks Collection:
    // Anyone can read artworks.
    // Portfolio owner can create, update, or delete artworks from the application.
    match /artworks/{artworkId} {
      allow read: if true;
      allow write: if true;
    }

    // Comments Collection:
    // Anyone can read and post comments.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Inbox Messages Collection:
    match /inbox_messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Shared tracking events
    match /tracking_events/{eventId} {
      allow read, write: if true;
    }
  }
}
