rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Artworks Collection:
    // Anyone can read artworks.
    // Anyone can increment/decrement likes/views/shares counts.
    // Artworks can be created or updated.
    match /artworks/{artworkId} {
      allow read: if true;
      allow write: if true;
    }

    // Comments Collection:
    // Anyone can read, post comments, or upvote comments.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Inbox Messages Collection:
    // Anyone can submit an inquiry/question.
    // Inbox can be read/updated by the owner.
    match /inbox_messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Shared tracking events (source metrics)
    match /tracking_events/{eventId} {
      allow read, write: if true;
    }
  }
}
