rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify if the authenticated user is Rishi Khare
    function isOwner() {
      return request.auth != null && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == 'rishikhare1224@gmail.com';
    }

    // Artworks Collection:
    // Anyone can read artworks.
    // ONLY the verified owner can create or delete artworks.
    // Non-owners can only update engagement counters (likesCount, sharesCount, viewsCount, commentsCount).
    match /artworks/{artworkId} {
      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'sharesCount', 'commentsCount', 'viewsCount'])
      );
    }

    // Comments Collection:
    // Anyone can read comments.
    // Anyone can submit visitor comments, but CANNOT spoof isArtist == true.
    // Only the verified owner can post comments with isArtist == true or delete comments.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if (
        request.resource.data.isArtist != true || isOwner()
      );
      allow update: if isOwner() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if isOwner();
    }

    // Inbox Messages Collection:
    // Anyone can submit an inquiry/question.
    // ONLY the owner can read, update, or delete inbox messages.
    match /inbox_messages/{messageId} {
      allow read: if isOwner();
      allow create: if true;
      allow update, delete: if isOwner();
    }

    // Shared tracking events (source metrics)
    match /tracking_events/{eventId} {
      allow read: if isOwner();
      allow create: if true;
      allow update, delete: if isOwner();
    }
  }
}
